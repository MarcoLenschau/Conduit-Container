FROM node:20-alpine AS builder

WORKDIR /app/

COPY ./frontend .

WORKDIR /app/frontend

RUN mkdir -p /app/frontend/src/environment && \
    echo "export const environment = { BACKEND_IP: '${BACKEND_URL}' };" > /app/frontend/src/environment/environment.ts

RUN npm install

RUN npm run build

FROM nginx:1.29.4-alpine

COPY --from=builder /app/dist/angular-conduit /usr/share/nginx/html

EXPOSE 80

ENTRYPOINT [ "nginx", "-g", "daemon off;" ]