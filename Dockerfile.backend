FROM python:3.5.2-alpine

WORKDIR /app

ARG ALLOWED_HOST

ARG CORS_ORIGIN

EXPOSE 5000

COPY ./backend ./backend

COPY entrypoint.sh .

WORKDIR /app/backend

RUN pip install -r requirements.txt && \
    echo "ALLOWED_HOST = ${ALLOWED_HOST}" >> /app/backend/conduit/.env && \
    echo "CORS_ORIGIN = ${CORS_ORIGIN}" >> /app/backend/conduit/.env && \
    chmod +x /app/entrypoint.sh

ENTRYPOINT ["/bin/sh", "/app/entrypoint.sh"]